<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- The client certificate is bound to this device's pairings; never restore it elsewhere. -->
    <cloud-backup>
        <exclude domain="file" path="client_identity.p12" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="client_identity.p12" />
    </device-transfer>
</data-extraction-rules>
