<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center"
    android:padding="12dp" android:background="@drawable/widget_bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="@string/app_name" android:textColor="@color/rv_icon" android:textSize="14sp" android:textStyle="bold" />
        <ImageButton android:id="@+id/btn_open_app" android:layout_width="32dp" android:layout_height="32dp"
            android:background="@android:color/transparent" android:src="@drawable/rv_open"
            android:contentDescription="@string/open_app" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center" android:layout_marginTop="6dp">
        <ImageButton android:id="@+id/btn_power" android:layout_width="36dp" android:layout_height="36dp" android:background="@drawable/rv_button_bg" android:src="@drawable/rv_power" android:contentDescription="@string/key_power" android:scaleType="center" />
        <ImageButton android:layout_marginStart="12dp" android:id="@+id/btn_play" android:layout_width="36dp" android:layout_height="36dp" android:background="@drawable/rv_button_bg" android:src="@drawable/rv_play" android:contentDescription="@string/key_play_pause" android:scaleType="center" />
        <ImageButton android:layout_marginStart="12dp" android:id="@+id/btn_mute" android:layout_width="36dp" android:layout_height="36dp" android:background="@drawable/rv_button_bg" android:src="@drawable/rv_mute" android:contentDescription="@string/key_mute" android:scaleType="center" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center" android:layout_marginTop="6dp">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
        <ImageButton android:id="@+id/btn_back" android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/rv_button_bg" android:src="@drawable/rv_back" android:contentDescription="@string/key_back" android:scaleType="center" />
        <ImageButton android:layout_marginTop="12dp" android:id="@+id/btn_home" android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/rv_button_bg" android:src="@drawable/rv_home" android:contentDescription="@string/key_home" android:scaleType="center" />
        </LinearLayout>
        <LinearLayout android:layout_marginStart="20dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
        <ImageButton android:id="@+id/btn_up" android:layout_width="36dp" android:layout_height="36dp" android:background="@drawable/rv_button_bg" android:src="@drawable/rv_up" android:contentDescription="@string/key_up" android:scaleType="center" />
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center">
        <ImageButton android:id="@+id/btn_left" android:layout_width="36dp" android:layout_height="36dp" android:background="@drawable/rv_button_bg" android:src="@drawable/rv_left" android:contentDescription="@string/key_left" android:scaleType="center" />
        <ImageButton android:layout_marginStart="4dp" android:id="@+id/btn_ok" android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/rv_button_bg" android:src="@drawable/rv_ok" android:contentDescription="@string/key_ok" android:scaleType="center" />
        <ImageButton android:layout_marginStart="4dp" android:id="@+id/btn_right" android:layout_width="36dp" android:layout_height="36dp" android:background="@drawable/rv_button_bg" android:src="@drawable/rv_right" android:contentDescription="@string/key_right" android:scaleType="center" />
            </LinearLayout>
        <ImageButton android:id="@+id/btn_down" android:layout_width="36dp" android:layout_height="36dp" android:background="@drawable/rv_button_bg" android:src="@drawable/rv_down" android:contentDescription="@string/key_down" android:scaleType="center" />
        </LinearLayout>
        <LinearLayout android:layout_marginStart="20dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
        <ImageButton android:id="@+id/btn_vol_up" android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/rv_button_bg" android:src="@drawable/rv_vol_up" android:contentDescription="@string/key_volume_up" android:scaleType="center" />
        <ImageButton android:layout_marginTop="12dp" android:id="@+id/btn_vol_down" android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/rv_button_bg" android:src="@drawable/rv_vol_down" android:contentDescription="@string/key_volume_down" android:scaleType="center" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
